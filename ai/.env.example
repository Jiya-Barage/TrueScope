# TrueScope AI Pipeline Environment Configuration
# Copy this file to ai/.env and populate paths if Tesseract or Poppler are not in your system PATH.

# Windows UB Mannheim Tesseract executable path:
# Example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Windows Poppler bin folder path containing pdftoppm.exe:
# Example: C:\Program Files\poppler\Library\bin or C:\poppler\Release-xx\bin
POPPLER_PATH=
